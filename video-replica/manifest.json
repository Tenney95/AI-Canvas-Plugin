{
  "apiVersion": 2,
  "minHostVersion": "0.10.2",
  "requiredCapabilities": [
    "python.executionTimeout",
    "python.mediaWorkspace",
    "invocation.cancel",
    "tool.effectBudgets",
    "video.nodeSetGeneration",
    "prompt.mentions",
    "video.replicaPipeline"
  ],
  "runtime": "python",
  "id": "com.aicanvas.video-replica",
  "name": "视频复刻",
  "version": "0.1.0",
  "author": "AI Canvas",
  "description": "一键复刻完整视频，可按模型能力自动分段或手动打点，提取音频对白、制作 ReShot 控制素材，通过已配置视频模型或 ComfyUI 生成并合成。",
  "license": "Apache-2.0",
  "category": "media",
  "keywords": [
    "视频复刻",
    "拉片",
    "分镜",
    "ReShot",
    "video-breakdown"
  ],
  "entry": "main.py",
  "permissions": [
    "node.read",
    "node.write",
    "models.read",
    "models.invoke",
    "files.connected.read",
    "files.output.create",
    "ui.custom",
    "prompt.references.read"
  ],
  "ui": {
    "entry": "ui.js",
    "integrity": "sha256-2ba4b1512a055f1941c84577e3866a2fb761a7b6bde76fb22ba4219ec75cee26",
    "exports": {
      "replica": "VideoReplica"
    }
  },
  "contributes": {
    "nodeTools": [
      {
        "id": "replicate",
        "pythonExecution": {
          "timeoutSeconds": 120,
          "mediaWorkspace": true
        },
        "title": "视频复刻",
        "description": "切镜、逐镜提示词与动作控制素材",
        "placements": [
          "node-context-menu",
          "node-toolbar"
        ],
        "icon": "lucide:clapperboard",
        "nodeTypes": [
          "source-video",
          "ai-video"
        ],
        "inputFields": [
          "label",
          "output",
          "videoUrl",
          "videoDuration"
        ],
        "resourceAccess": {
          "self": true
        },
        "dialog": {
          "title": "视频复刻",
          "description": "选择模型后一键复刻全片，也可手动打点或进入高级镜头编辑。",
          "submitLabel": "生成复刻素材",
          "fields": [],
          "ui": "replica",
          "presentation": "window"
        },
        "output": {
          "mode": "create-node-set",
          "generateVideos": true,
          "nodeTypes": [
            "source-video",
            "ai-markdown",
            "ai-shotlist",
            "source-image",
            "ai-video"
          ],
          "maxNodes": 25,
          "fields": [
            "label",
            "output",
            "shotlistRows",
            "frameAnalysis",
            "prompt"
          ]
        }
      }
    ]
  }
}
